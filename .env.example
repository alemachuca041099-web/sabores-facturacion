# true (default si no pones esta línea) = modo simulación: nada se conecta a
# Facturama, los clientes y facturas se guardan en data/simulation.json, y el
# PDF se genera aquí mismo con una marca de agua de "SIMULACIÓN". Sirve para
# probar todo el flujo del panel antes de tener la cuenta real.
# Cuando ya tengas cuenta y credenciales de Facturama, pon esto en "false".
SIMULATION_MODE=true

# --- Lo de abajo solo hace falta cuando SIMULATION_MODE=false ---------------

# Credenciales de la API de Facturama (Configuración > Credenciales de API en
# tu cuenta). A diferencia de otros proveedores, Facturama usa usuario y
# contraseña (HTTP Basic), no una sola "llave".
FACTURAMA_USER=tu_usuario_de_api
FACTURAMA_PASSWORD=tu_password_de_api

# Código postal del domicilio fiscal de SABORES (el que está en su
# Constancia de Situación Fiscal) — lo pide el SAT en cada factura como
# "lugar de expedición".
FACTURAMA_EXPEDITION_ZIP=76800

# false = ambiente de pruebas (apisandbox.facturama.mx, no timbra de verdad).
# true = ambiente real (api.facturama.mx, timbra ante el SAT de verdad).
FACTURAMA_LIVE=false

# --- Esto siempre hace falta, en cualquier modo -----------------------------

# Contraseña única para entrar al panel (compártela solo con quien capture ventas).
PANEL_PASSWORD=cambia-esta-contrasena

# Secreto para firmar la sesión del login (cualquier texto largo y aleatorio).
SESSION_SECRET=cambia-esto-tambien-por-algo-largo-y-aleatorio

PORT=3000
